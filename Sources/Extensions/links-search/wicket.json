{
  "contract": 2,
  "name": "Quicklinks",
  "description": "Open your saved links and site searches.",
  "keyword": "links",
  "command": ["./main"],
  "icon": "link",
  "itemList": {
    "empty": {
      "id": "add-quicklink",
      "title": "Add a Quicklink…",
      "icon": "plus",
      "actions": [{"type":"open","url":"wicket://settings?input=links-search/links"}]
    }
  },
  "fields": [{"name":"query","type":"text","description":"Query","placeholder":"Search query"}],
  "settings": [
    {
      "name": "links",
      "type": "list",
      "description": "Bookmarks",
      "itemName": "Bookmark",
      "fields": [
        {"name":"title","type":"text","description":"Name shown in the launcher","placeholder":"Title"},
        {"name":"url","type":"text","description":"Use a complete URL, including its scheme","placeholder":"URL"},
        {"name":"keyword","type":"text","description":"Optional shortcut to find this bookmark","placeholder":"Keyword","optional":true}
      ],
      "item": {
        "title": "{title}",
        "keywords": ["{keyword}"],
        "actions": [{"type":"open","url":"{url}"}]
      }
    },
    {
      "name": "searches",
      "type": "list",
      "description": "Site Searches",
      "itemName": "Site Search",
      "fields": [
        {"name":"title","type":"text","description":"Name shown in the launcher","placeholder":"Title"},
        {"name":"url","type":"text","description":"Put {query} where the search text goes","placeholder":"URL"},
        {"name":"keyword","type":"text","description":"Type this shortcut before your search text","placeholder":"Keyword"}
      ],
      "item": {
        "title": "{title}",
        "keywords": ["{keyword}"],
        "actions": [
          {"type":"run","action":"open-link","hidden":true,"promptIfEmpty":true,"fields":{"template":"{url}"}}
        ]
      }
    }
  ]
}
