{
  "name": "Calculator",
  "description": "Calculates arithmetic as you type, such as 12 * 4.5 or =15% of 80.",
  "icon": "equal",
  "command": ["./main"],
  "match": "\\A(?:\\s*=[\\s\\S]*|(?=[\\s\\S]*\\p{Nd})(?=[\\s\\S]*[-+−*/×÷^%])[-+−*/×÷^%().,\\p{Nd}\\s'’٫٬]+)\\z",
  "contract": 2,
  "version": "1.0.0",
  "settings": [
    {"name": "inputFormat", "type": "choice", "description": "Input decimal mark", "options": ["Locale", "Dot", "Comma"], "default": "Locale"},
    {"name": "outputFormat", "type": "choice", "description": "Output format", "options": ["Automatic", "Fixed", "Scientific"], "default": "Automatic"},
    {"name": "precision", "type": "choice", "placeholder": "Precision", "description": "Significant digits (at least one), or decimal places in Fixed", "options": ["0", "1", "2", "3", "4", "5"], "default": "2"}
  ]
}
