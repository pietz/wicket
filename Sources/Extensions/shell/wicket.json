{
  "name": "Shell",
  "description": "Opens a command typed after > in your chosen terminal, in your home folder.",
  "icon": "terminal",
  "command": ["./main"],
  "match": "^>",
  "contract": 2,
  "settings": [
    {
      "name": "terminal",
      "type": "choice",
      "placeholder": "Terminal app",
      "description": "App to run Shell commands. System default uses the macOS handler for .command files.",
      "default": "default",
      "options": [
        {"value": "default", "label": "System default"},
        {"value": "com.apple.Terminal", "label": "Terminal", "requiresApp": "com.apple.Terminal"},
        {"value": "com.googlecode.iterm2", "label": "iTerm2", "requiresApp": "com.googlecode.iterm2"},
        {"value": "com.mitchellh.ghostty", "label": "Ghostty", "requiresApp": "com.mitchellh.ghostty"}
      ]
    }
  ]
}
