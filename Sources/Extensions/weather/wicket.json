{
  "contract": 2,
  "version": "1.0.0",
  "name": "Weather",
  "description": "Current conditions and forecasts for a city, from Open-Meteo.",
  "keyword": "weather",
  "icon": "cloud.sun",
  "command": ["./main"],
  "match": "(?i)^\\s*weather\\s+(?!in\\s*$)\\S.*$",
  "submit": true,
  "fields": [{"name": "city", "type": "text", "description": "City or place", "placeholder": "City"}],
  "settings": [
    {"name": "defaultCity", "type": "text", "description": "Shown when you open Weather without typing a city, e.g. Berlin", "placeholder": "Default city"},
    {"name": "units", "type": "choice", "description": "Temperature unit", "options": ["Celsius", "Fahrenheit"], "default": "Celsius"}
  ]
}
