{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wicket extension protocol 2",
  "description": "The whole document validates wicket.json. Each run is validated against #/$defs/Request (Wicket to extension, on stdin) and #/$defs/Response (extension to Wicket, on stdout). See docs/extensions.md.",
  "$ref": "#/$defs/Manifest",
  "$defs": {
    "Manifest": {
      "type": "object",
      "required": ["protocol", "id", "name", "version", "run", "commands"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "protocol": { "const": 2, "description": "Protocol version this extension speaks." },
        "id": { "$ref": "#/$defs/Slug", "description": "Unique, stable id; also the folder name." },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "description": "One sentence, shown on the review screen." },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "icon": { "$ref": "#/$defs/Icon" },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Program and arguments, started in the extension folder. A bare name is looked up on the login shell PATH. Not uv or uvx: vendor packages into the folder."
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["network", "clipboard", "files", "shell"] },
          "description": "What the code does beyond answering, shown on the review screen. Not enforced."
        },
        "secrets": {
          "type": "array",
          "items": { "$ref": "#/$defs/Secret" },
          "description": "Values stored in the Keychain and passed as environment variables. Names must be unique."
        },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Command" } }
      }
    },
    "Secret": {
      "type": "object",
      "required": ["name", "title"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?!WICKET_)(?!(PATH|LANG|HOME|USER|SHELL|TMPDIR|_)$)[A-Z_][A-Z0-9_]*$",
          "description": "Environment variable name."
        },
        "title": { "type": "string", "minLength": 1, "description": "What the user is asked for." }
      }
    },
    "Command": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "icon": { "$ref": "#/$defs/Icon" },
        "mode": { "enum": ["once", "live"], "default": "once" },
        "keyword": { "type": "string", "pattern": "^\\S+$" },
        "search": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" }, "description": "Words and phrases a person would type to find this command locally; equivalent title matches rank higher." },
        "placeholder": { "type": "string" },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "Slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "Icon": {
      "oneOf": [
        {
          "type": "object",
          "required": ["symbol"],
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": { "name": { "type": "string", "minLength": 1, "description": "SF Symbol name." } }
            }
          }
        },
        {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "object",
              "required": ["url"],
              "additionalProperties": false,
              "properties": { "url": { "$ref": "#/$defs/Location", "description": "Shows this file's Finder icon." } }
            }
          }
        }
      ]
    },
    "Location": {
      "type": "string",
      "minLength": 1,
      "description": "A URL (https:, file:, mailto:, an app scheme) or an absolute or ~/ path."
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["title"] }, { "required": ["file"] }, { "required": ["url"] }],
      "not": { "required": ["file", "url"] },
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique within the response; defaults to the subject (a file's path, a link), else the title." },
        "title": { "type": "string", "minLength": 1, "description": "Main text. Required unless the item has a subject (file or url), which names it otherwise." },
        "subtitle": { "type": "string" },
        "icon": { "$ref": "#/$defs/Icon" },
        "accessory": { "type": "string", "description": "Short text at the trailing edge." },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/Action" } },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "The file or folder this row is: an absolute or ~/ path, or a file: URL. Wicket adds its name, folder, icon and actions (Open, Reveal in Finder, Copy Path). Not with url."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "The link this row is (https:, mailto:, an app scheme). Wicket adds its host, path, icon and actions (Open, Copy Link). Not with file."
        }
      }
    },
    "List": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["items"] }, { "required": ["sections"] }],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "description": "Markup (docs/markup.md) shown above the rows: a sentence or two of context. Nothing in it is selectable." },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/Fact" }, "description": "Labelled values shown under the summary, up to four beside the rows." },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/Item" } },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/Section" }, "description": "Titled groups of rows, instead of items; up to 500 rows in all." }
      }
    },
    "Section": {
      "type": "object",
      "required": ["title", "items"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/Item" } }
      }
    },
    "Fact": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
    },
    "Detail": {
      "type": "object",
      "required": ["markdown"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "markdown": { "type": "string", "description": "Markup: Markdown with Wicket's component tags (docs/markup.md)." },
        "metadata": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/Action" } }
      }
    },
    "Action": {
      "oneOf": [
        { "$ref": "#/$defs/OpenAction" },
        { "$ref": "#/$defs/CopyAction" },
        { "$ref": "#/$defs/PasteAction" },
        { "$ref": "#/$defs/DetailAction" },
        { "$ref": "#/$defs/RunAction" }
      ]
    },
    "OpenAction": {
      "type": "object",
      "required": ["open"],
      "additionalProperties": false,
      "properties": {
        "open": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": { "url": { "$ref": "#/$defs/Location" }, "title": { "type": "string" } }
        }
      }
    },
    "CopyAction": {
      "type": "object",
      "required": ["copy"],
      "additionalProperties": false,
      "properties": {
        "copy": {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": { "text": { "type": "string" }, "title": { "type": "string" } }
        }
      }
    },
    "PasteAction": {
      "type": "object",
      "required": ["paste"],
      "additionalProperties": false,
      "properties": {
        "paste": {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": { "text": { "type": "string" }, "title": { "type": "string" } }
        }
      }
    },
    "DetailAction": {
      "type": "object",
      "required": ["detail"],
      "additionalProperties": false,
      "properties": { "detail": { "$ref": "#/$defs/Detail" } }
    },
    "RunAction": {
      "type": "object",
      "required": ["run"],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": { "$ref": "#/$defs/Slug", "description": "A command id from this extension's manifest." },
            "args": { "type": "object", "description": "Any JSON object, passed back in run params." },
            "title": { "type": "string" }
          }
        }
      }
    },
    "Result": {
      "oneOf": [
        {
          "type": "object",
          "required": ["answer"],
          "additionalProperties": false,
          "properties": { "answer": { "$ref": "#/$defs/Item" } }
        },
        {
          "type": "object",
          "required": ["list"],
          "additionalProperties": false,
          "properties": { "list": { "$ref": "#/$defs/List" } }
        },
        {
          "type": "object",
          "required": ["detail"],
          "additionalProperties": false,
          "properties": { "detail": { "$ref": "#/$defs/Detail" } }
        },
        {
          "type": "object",
          "required": ["close"],
          "additionalProperties": false,
          "properties": { "close": { "$ref": "#/$defs/Notice" } }
        },
        {
          "type": "object",
          "required": ["reload"],
          "additionalProperties": false,
          "properties": { "reload": { "$ref": "#/$defs/Notice" } }
        }
      ]
    },
    "Notice": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "message": { "type": "string", "description": "Shown briefly, then fades." } }
    },
    "Request": {
      "type": "object",
      "required": ["command", "text"],
      "additionalProperties": false,
      "properties": {
        "command": { "$ref": "#/$defs/Slug" },
        "text": { "type": "string" },
        "args": { "type": "object" }
      }
    },
    "Response": {
      "oneOf": [
        { "$ref": "#/$defs/Result" },
        {
          "type": "object",
          "required": ["error"],
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "object",
              "required": ["message"],
              "additionalProperties": false,
              "properties": {
                "message": { "type": "string", "minLength": 1, "description": "One short line, shown to the user." },
                "data": { "description": "Anything; kept in the run's history, never shown inline." }
              }
            }
          }
        }
      ]
    }
  }
}
