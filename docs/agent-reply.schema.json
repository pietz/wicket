{
  "$defs" : {
    "Action" : {
      "anyOf" : [
        {
          "$ref" : "#/$defs/OpenAction"
        },
        {
          "$ref" : "#/$defs/CopyAction"
        },
        {
          "$ref" : "#/$defs/DetailAction"
        }
      ]
    },
    "CopyAction" : {
      "additionalProperties" : false,
      "properties" : {
        "copy" : {
          "additionalProperties" : false,
          "properties" : {
            "text" : {
              "type" : "string"
            },
            "title" : {
              "anyOf" : [
                {
                  "type" : "string"
                },
                {
                  "type" : "null"
                }
              ]
            }
          },
          "required" : [
            "text",
            "title"
          ],
          "type" : "object"
        }
      },
      "required" : [
        "copy"
      ],
      "type" : "object"
    },
    "Detail" : {
      "additionalProperties" : false,
      "properties" : {
        "actions" : {
          "anyOf" : [
            {
              "items" : {
                "$ref" : "#/$defs/Action"
              },
              "type" : "array"
            },
            {
              "type" : "null"
            }
          ]
        },
        "markdown" : {
          "type" : "string"
        },
        "metadata" : {
          "anyOf" : [
            {
              "items" : {
                "$ref" : "#/$defs/Fact"
              },
              "type" : "array"
            },
            {
              "type" : "null"
            }
          ]
        },
        "title" : {
          "anyOf" : [
            {
              "type" : "string"
            },
            {
              "type" : "null"
            }
          ]
        }
      },
      "required" : [
        "actions",
        "markdown",
        "metadata",
        "title"
      ],
      "type" : "object"
    },
    "DetailAction" : {
      "additionalProperties" : false,
      "properties" : {
        "detail" : {
          "$ref" : "#/$defs/Detail"
        }
      },
      "required" : [
        "detail"
      ],
      "type" : "object"
    },
    "Fact" : {
      "additionalProperties" : false,
      "properties" : {
        "label" : {
          "type" : "string"
        },
        "value" : {
          "type" : "string"
        }
      },
      "required" : [
        "label",
        "value"
      ],
      "type" : "object"
    },
    "Item" : {
      "additionalProperties" : false,
      "properties" : {
        "accessory" : {
          "anyOf" : [
            {
              "description" : "Short text at the trailing edge.",
              "type" : "string"
            },
            {
              "type" : "null"
            }
          ]
        },
        "actions" : {
          "anyOf" : [
            {
              "items" : {
                "$ref" : "#/$defs/Action"
              },
              "type" : "array"
            },
            {
              "type" : "null"
            }
          ]
        },
        "file" : {
          "anyOf" : [
            {
              "description" : "The file or folder this row is: an absolute or ~/ path, or a file: URL. Wicket adds its name, folder, icon and actions (Open, Reveal in Finder, Copy Path). Not with url.",
              "type" : "string"
            },
            {
              "type" : "null"
            }
          ]
        },
        "subtitle" : {
          "anyOf" : [
            {
              "type" : "string"
            },
            {
              "type" : "null"
            }
          ]
        },
        "title" : {
          "anyOf" : [
            {
              "description" : "Main text. Required unless the item has a subject (file or url), which names it otherwise.",
              "type" : "string"
            },
            {
              "type" : "null"
            }
          ]
        },
        "url" : {
          "anyOf" : [
            {
              "description" : "The link this row is (https:, mailto:, an app scheme). Wicket adds its host, path, icon and actions (Open, Copy Link). Not with file.",
              "type" : "string"
            },
            {
              "type" : "null"
            }
          ]
        }
      },
      "required" : [
        "accessory",
        "actions",
        "file",
        "subtitle",
        "title",
        "url"
      ],
      "type" : "object"
    },
    "List" : {
      "additionalProperties" : false,
      "properties" : {
        "facts" : {
          "anyOf" : [
            {
              "description" : "Labelled values shown under the summary, up to four beside the rows.",
              "items" : {
                "$ref" : "#/$defs/Fact"
              },
              "type" : "array"
            },
            {
              "type" : "null"
            }
          ]
        },
        "items" : {
          "anyOf" : [
            {
              "items" : {
                "$ref" : "#/$defs/Item"
              },
              "maxItems" : 500,
              "type" : "array"
            },
            {
              "type" : "null"
            }
          ]
        },
        "sections" : {
          "anyOf" : [
            {
              "description" : "Titled groups of rows, instead of items; up to 500 rows in all.",
              "items" : {
                "$ref" : "#/$defs/Section"
              },
              "type" : "array"
            },
            {
              "type" : "null"
            }
          ]
        },
        "summary" : {
          "anyOf" : [
            {
              "description" : "Markdown shown above the rows: a sentence or two of context.",
              "type" : "string"
            },
            {
              "type" : "null"
            }
          ]
        }
      },
      "required" : [
        "facts",
        "items",
        "sections",
        "summary"
      ],
      "type" : "object"
    },
    "Location" : {
      "description" : "A URL (https:, file:, mailto:, an app scheme) or an absolute or ~/ path.",
      "type" : "string"
    },
    "OpenAction" : {
      "additionalProperties" : false,
      "properties" : {
        "open" : {
          "additionalProperties" : false,
          "properties" : {
            "title" : {
              "anyOf" : [
                {
                  "type" : "string"
                },
                {
                  "type" : "null"
                }
              ]
            },
            "url" : {
              "$ref" : "#/$defs/Location"
            }
          },
          "required" : [
            "title",
            "url"
          ],
          "type" : "object"
        }
      },
      "required" : [
        "open"
      ],
      "type" : "object"
    },
    "Screen" : {
      "anyOf" : [
        {
          "additionalProperties" : false,
          "properties" : {
            "answer" : {
              "$ref" : "#/$defs/Item"
            }
          },
          "required" : [
            "answer"
          ],
          "type" : "object"
        },
        {
          "additionalProperties" : false,
          "properties" : {
            "list" : {
              "$ref" : "#/$defs/List"
            }
          },
          "required" : [
            "list"
          ],
          "type" : "object"
        },
        {
          "additionalProperties" : false,
          "properties" : {
            "detail" : {
              "$ref" : "#/$defs/Detail"
            }
          },
          "required" : [
            "detail"
          ],
          "type" : "object"
        }
      ]
    },
    "Section" : {
      "additionalProperties" : false,
      "properties" : {
        "items" : {
          "items" : {
            "$ref" : "#/$defs/Item"
          },
          "type" : "array"
        },
        "title" : {
          "type" : "string"
        }
      },
      "required" : [
        "items",
        "title"
      ],
      "type" : "object"
    }
  },
  "additionalProperties" : false,
  "properties" : {
    "reply" : {
      "$ref" : "#/$defs/Screen"
    }
  },
  "required" : [
    "reply"
  ],
  "type" : "object"
}
